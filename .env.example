# Reference only: put Worker-local values in ignored .dev.vars.
# DB is a Cloudflare D1 binding configured in Wrangler, not a string variable.
# Vite supplies development flags locally. Public deployments must disable local auth.
APP_ENV=production
ENABLE_LOCAL_AUTH=false

# Resend email. APP_URL must be the real HTTPS application origin.
APP_URL=https://echo.example.edu
EMAIL_FROM=CampusCrate Echo <no-reply@example.edu>
EMAIL_API_KEY=

# Optional compatible text moderation endpoint, server-only.
# Without a provider, basic local rules run; human moderation is still needed.
MODERATION_API_URL=
MODERATION_API_KEY=
MODERATION_MODEL=omni-moderation-latest

# Provisional policy configuration. Keep POLICY_STATUS=draft until an authorized
# operator approves every required value. Blank values remain visible as pending.
POLICY_STATUS=draft
POLICY_OPERATOR_NAME=
POLICY_SUPPORT_CONTACT=
POLICY_PRIVACY_CONTACT=
POLICY_GRIEVANCE_CONTACT=
POLICY_URGENT_SAFETY_CONTACT=
POLICY_APPEAL_CONTACT=
POLICY_SUPPORT_RESPONSE_TARGET=
POLICY_EFFECTIVE_DATE=
POLICY_VERSION=
POLICY_LAUNCH_REGIONS=
POLICY_MINIMUM_AGE=18
POLICY_ENROLLMENT_CRITERIA=
POLICY_PROVIDER_SUMMARY=
POLICY_RETENTION_SUMMARY=

# Voice, uploads, push and third-party analytics/error SDKs are not connected.
# See docs/EXTERNAL-SETUP.md before configuring or enabling those features.
